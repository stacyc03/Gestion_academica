{
  "info": {
    "name": "Sesión 12 - Gestión Académica",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090/api/v1"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "estudianteId",
      "value": "1"
    },
    {
      "key": "carreraId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Listar estudiantes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/estudiantes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listado 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta es un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "const rows = pm.response.json(); if(Array.isArray(rows) && rows.length) pm.collectionVariables.set('estudianteId', rows[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Detalle",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/estudiantes/{{estudianteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Detalle 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Sin token (401 esperado)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/estudiantes",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sin token 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Crear carrera de prueba (solo ADMIN, opcional)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/carreras",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"SIS-PRACTICA\",\n  \"nombre\": \"Ingeniería en Sistemas\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Creación 201', () => pm.response.to.have.status(201));",
              "if(pm.response.code === 201) pm.collectionVariables.set('carreraId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Crear estudiante de prueba (solo ADMIN, opcional)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/estudiantes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Estudiante de práctica\",\n  \"correo\": \"practica@example.test\",\n  \"edad\": 22,\n  \"carrera\": {{carreraId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}